# Template Source Strategy: gdrive | onedrive | local
TEMPLATE_SOURCE=local

# Google Drive Auth
GOOGLE_APPLICATION_CREDENTIALS="secrets/service_account.json"

# OneDrive Auth (Future use)
ONEDRIVE_CLIENT_ID="your-client-id"
ONEDRIVE_TENANT_ID="common"

# Generation Settings
TEMPLATE_REMOTE_NAME="resume_template.docx"
